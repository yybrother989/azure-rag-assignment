# ===== Azure Blob Storage =====
AZURE_STORAGE_ACCOUNT=<storage-account-name>
AZURE_STORAGE_CONTAINER=kb-docs

# ===== Azure AI Search =====
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=kb-chunks
AZURE_SEARCH_API_KEY=<admin-key>
AZURE_SEARCH_SEMANTIC_CONFIG=kb-semantic

# ===== Azure AI Foundry (PRIMARY model access path, AAD-authed) =====
# When set, embed.py authenticates via DefaultAzureCredential against the
# AI Services account (cognitiveservices.azure.com endpoint — the proven
# OpenAI inference path). The Foundry project still owns RBAC; this var
# triggers AAD auth. When unset, falls back to direct AzureOpenAI key auth.
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<ai-services>.services.ai.azure.com/api/projects/<project>
AZURE_AI_FOUNDRY_PROJECT_NAME=kb-rag-project

# ===== Azure OpenAI / AI Services (fallback + deployment names) =====
# Endpoint + key are kept for the fallback codepath. Deployment names are
# always required (they identify which model to call).
AZURE_OPENAI_ENDPOINT=https://<ai-services>.services.ai.azure.com
AZURE_OPENAI_API_KEY=<key — optional when Foundry path + AAD is used>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# gpt-4o-mini@2024-07-18 is deprecated for new deployments — see provisioning gotcha #2
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# ===== Azure Document Intelligence =====
# Primary PDF extractor. Produces page boundary markers, table refs, and
# figure bounding boxes used by chunk.py and figures.py.
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<di-resource>.cognitiveservices.azure.com
AZURE_DOC_INTELLIGENCE_KEY=<key>

# ===== Pipeline tuning =====
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5
EVIDENCE_TOP_N=4
LOG_TRACE_JSONL=traces.jsonl

# ===== Optional: Azure AI Content Safety =====
# If unset, all safety checks silently pass (useful for local dev).
AZURE_CONTENT_SAFETY_ENDPOINT=https://<content-safety>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=<key>

# ===== Optional: Azure Monitor / Application Insights =====
# If unset, telemetry spans become no-ops.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=...

# ===== Optional: Figure rendering (PDF-only, DI backend) =====
# Set ENABLE_FIGURE_CAPTIONS=1 to caption each figure via gpt-4o vision (~$0.01/figure).
ENABLE_FIGURE_CAPTIONS=0
AZURE_FIGURES_CONTAINER=kb-figures
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o

# ===== Optional: Function App control for sync.py --full-rebuild =====
# When both are set and `az` CLI is on PATH, sync.py --full-rebuild will stop the
# Function App before wiping/rebuilding the index and restart it afterwards. This
# eliminates the race between manual rebuilds and the blob-trigger ingestion path.
# Leave unset to skip stop/start (e.g. environments without Function App access).
AZURE_FUNCTION_APP=<function-app-name>
AZURE_RESOURCE_GROUP=<resource-group-name>
